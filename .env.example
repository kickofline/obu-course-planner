# Export in your shell or set in your deployment platform; not loaded automatically.
# API: allowed browser origins, comma separated. Defaults to local Astro development origins.
PLANNER_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Optional public frontend URL, displayed at the API root and in worksheet footers.
PLANNER_SITE_URL=https://planner.example/courses
# Optional paths; omitted values use the packaged catalog bundles and schedule seed.
# OBU_PLANNER_DATA=/data/catalogs
# OBU_SCHEDULE_SNAPSHOT=/data/schedule/schedule-snapshot.json
# Request identity for OBU refreshes. Set your own contact information in private config.
# Default identifies this project's GitHub repository.
OBU_REFRESH_USER_AGENT=obu-course-planner (+https://planner.example/courses)

# Only the optional deploy/refresh_schedule.py runner uses these:
# Put them in /etc/obu-course-planner/refresh.env on the Docker host.
OBU_PLANNER_CONTAINER=course-planner-
OBU_PLANNER_VOLUME=course-planner-schedule
