# Export in your shell or set in your deployment platform; not loaded automatically.

# Browser origins allowed to call the API (CORS/POST) and to embed the UI in an iframe
# (Content-Security-Policy frame-ancestors on /courses). Comma separated.
# List BOTH the origin that serves this app standalone (where /courses/ lives, behind your proxy)
# AND every site that embeds it via /courses/embed.js. Defaults to the local dev origins below.
PLANNER_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:8000,http://127.0.0.1:8000
# Optional public planner URL, shown at the API root and printed in worksheet footers.
# PLANNER_SITE_URL=https://example.edu/courses

# Optional data paths; omitted values use the packaged catalog bundles and schedule seed.
# OBU_PLANNER_DATA=/data/catalogs
# OBU_SCHEDULE_SNAPSHOT=/data/schedule/schedule-snapshot.json

# Refresh-only native helper; Dockerfile.refresh supplies both defaults.
# Override these only when running a separately built helper outside the worker image.
# OBU_CFSOLVE_EXECUTABLE=obu-cfsolve
# OBU_CFSOLVE_PROFILE=/opt/cfsolve/profiles/safari-26-ios.json

# Only the optional deploy/refresh_schedule.py runner uses these.
# Put them in /etc/obu-course-planner/refresh.env on the Docker host.
# OBU_PLANNER_REFRESH_IMAGE = the refresher image built from Dockerfile.refresh (e.g. obu-course-planner-refresh:2026-10-28)
# OBU_PLANNER_VOLUME = the docker volume that holds schedule-snapshot.json
OBU_PLANNER_REFRESH_IMAGE=obu-course-planner-refresh:local
OBU_PLANNER_VOLUME=course-planner-schedule
