+++ b/examples/obu_refresh.rs
@@ -0,0 +1,93 @@
+//! JSONL transport for the Python schedule refresher; never prints tokens or cookies.
+use std::{io::{self, BufRead, Write}, path::PathBuf, time::Duration};
+use anyhow::{Context, Result, bail, ensure};
+use cfsolve::{Browser, Options, Url};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+#[derive(Deserialize)]
+struct Command {
+    method: String,
+    url: Option<String>,
+    #[serde(default)]
+    data: serde_json::Map<String, Value>,
+}
+
+// Do not leak challenge URLs, payloads or cookies through a wrapped upstream error chain.
+fn failure(error: &anyhow::Error) -> &'static str {
+    match error.downcast_ref::<cfsolve::Error>() {
+        Some(cfsolve::Error::Config(_)) => "Invalid native solver configuration",
+        Some(cfsolve::Error::Network(_)) => "Network request failed; capture aborted",
+        Some(cfsolve::Error::Unsupported(_)) => "Unsupported Cloudflare challenge; capture aborted",
+        Some(cfsolve::Error::Rejected { .. }) => "Cloudflare rejected this session; capture aborted",
+        Some(cfsolve::Error::Blocked { .. }) => "Upstream blocked this session; capture aborted",
+        Some(cfsolve::Error::Challenged { .. }) => "Unexpected challenge; capture aborted",
+        _ => "Schedule request failed or timed out; snapshot not replaced",
+    }
+}
+
+fn main() -> Result<()> {
+    let mut profile = PathBuf::from("/opt/cfsolve/profiles/safari-26-ios.json");
+    let mut interval_ms = 1000;
+    let mut args = std::env::args().skip(1);
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--profile" => profile = args.next().context("Missing --profile value")?.into(),
+            "--interval-ms" => interval_ms = args.next().context("Missing --interval-ms value")?.parse()?,
+            _ => bail!("Unknown argument {arg}"),
+        }
+    }
+    ensure!((100..=10000).contains(&interval_ms), "Request interval must be 100-10000 ms");
+    let browser = Browser::read(profile)?;
+    let options = Options::default();
+    let rt = tokio::runtime::Builder::new_multi_thread().worker_threads(2).enable_all().build()?;
+    let outcome = rt.block_on(async {
+        let mut session = browser.refresh_session(&options, Duration::from_millis(interval_ms), 400,
+            vec!["info.obu.edu".into(), "challenges.cloudflare.com".into()])?;
+        let input = io::stdin();
+        let output = io::stdout();
+        let mut output = output.lock();
+        for line in input.lock().lines() {
+            let parsed: Result<Command> = (|| {
+                let line = line?;
+                ensure!(line.len() <= 65536, "Command exceeds 64 KiB");
+                Ok(serde_json::from_str(&line)?)
+            })();
+            let command = match parsed {
+                Ok(c) => c,
+                Err(_) => {
+                    writeln!(output, "{}", json!({"ok":false,"error":"Invalid refresh command","request_count":session.request_count()}))?;
+                    output.flush()?;
+                    break;
+                }
+            };
+            if command.method == "CLOSE" {
+                writeln!(output, "{}", json!({"ok":true,"request_count":session.request_count()}))?;
+                output.flush()?;
+                break;
+            }
+            let fields = command.data.into_iter().map(|(k, v)| {
+                Ok((k, v.as_str().context("Form values must be strings")?.to_owned()))
+            }).collect::<Result<Vec<_>>>();
+            let result = async {
+                let url = Url::parse(&command.url.context("Missing URL")?)?;
+                let fields = fields?;
+                match tokio::time::timeout(Duration::from_secs(100), session.request(&command.method, &url, &fields)).await {
+                    Ok(r) => r,
+                    Err(_) => bail!("Refresh request exceeded 100 seconds"),
+                }
+            }.await;
+            let failed = result.is_err();
+            let reply = match result {
+                Ok(page) => json!({"ok":true,"status":page.status.as_u16(),"html":page.html,"request_count":session.request_count()}),
+                Err(error) => json!({"ok":false,"error":failure(&error),"request_count":session.request_count()}),
+            };
+            writeln!(output, "{reply}")?;
+            output.flush()?;
+            if failed { break; }
+        }
+        anyhow::Ok(())
+    });
+    rt.shutdown_timeout(Duration::from_secs(5));
+    outcome
+}
