@@ -0,0 +1,69 @@
+//! Persistent, bounded schedule session. A clearance is attempted only on the initial GET.
+use std::time::Duration;
+use anyhow::{Result, bail, ensure};
+use url::Url;
+use crate::{Browser, Options, PageDocument};
+use crate::http::{self, BrowserClient};
+use crate::session::{self, Discard, Expect, Outcome};
+use wreq::{NetworkGate, StatusCode};
+
+/// One capture's persistent client, cookie jar, request budget, and clearance state.
+pub struct RefreshSession<'a> {
+    browser: &'a Browser,
+    options: &'a Options,
+    client: BrowserClient,
+    gate: NetworkGate,
+    previous: Option<Url>,
+    clearance_attempted: bool,
+}
+
+impl Browser {
+    /// Reuse the exact client, fingerprint, cookies, egress and pacing for an entire capture.
+    pub fn refresh_session<'a>(&'a self, options: &'a Options, interval: Duration,
+                              request_limit: u64, hosts: Vec<String>) -> Result<RefreshSession<'a>> {
+        let gate = NetworkGate::new(interval, request_limit, hosts)?;
+        let client = self.transport.client(options.proxy.as_deref(), Some(gate.clone()))?;
+        Ok(RefreshSession { browser: self, options, client, gate, previous: None, clearance_attempted: false })
+    }
+}
+
+impl RefreshSession<'_> {
+    /// Count all admitted requests, including challenge traffic and redirects.
+    pub fn request_count(&self) -> u64 { self.gate.count() }
+
+    /// Navigate or submit a form; only the first GET may attempt challenge clearance.
+    /// Any subsequent challenge or non-success response returns an error without replay.
+    pub async fn request(&mut self, method: &str, url: &Url,
+                         fields: &[(String, String)]) -> Result<PageDocument> {
+        let initial = self.previous.is_none();
+        let document = match method {
+            "GET" => {
+                let (document, navigation) = session::navigate(&self.client, url).await.map_err(crate::Error::classify)?;
+                if document.status == StatusCode::FORBIDDEN {
+                    ensure!(initial && !self.clearance_attempted,
+                            "Session challenged again; capture aborted without replaying a request");
+                    self.clearance_attempted = true;
+                    let sink = self.options.sink.as_deref().unwrap_or(&Discard);
+                    match session::native(&self.client, sink, document, navigation,
+                                          &self.browser.page, Expect::ChallengePage,
+                                          &self.browser.solve).await.map_err(crate::Error::classify)? {
+                        Outcome::Cleared(clearance) => clearance.page,
+                        Outcome::Token(_) => bail!("Expected challenge clearance, not a widget token"),
+                    }
+                } else { document }
+            }
+            "POST" => {
+                let previous = self.previous.as_ref().ok_or_else(|| anyhow::anyhow!("Open the schedule before submitting a form"))?;
+                http::submit_form(&self.client, previous, url, fields).await.map_err(crate::Error::classify)?
+            }
+            _ => bail!("Only GET and POST are supported"),
+        };
+        ensure!(document.status.is_success(), "Schedule returned HTTP {}", document.status);
+        ensure!(document.html.len() <= 4 * 1024 * 1024, "Schedule response exceeds 4 MiB");
+        self.previous = Some(document.url.clone());
+        Ok(document)
+    }
+}
+
+#[cfg(test)]
+mod tests;
