index 0000000..c8b9eae
--- /dev/null
+++ b/src/refresh/tests.rs
@@ -0,0 +1,105 @@
+use super::*;
+use std::{io::{BufRead, BufReader, Read, Write}, net::TcpListener, thread, time::Instant};
+
+struct Received { head: String, body: String }
+
+// The origin observes real requests, including the ones followed internally by wreq.
+fn serve(responses: Vec<String>) -> (Url, thread::JoinHandle<Vec<Received>>) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = Url::parse(&format!("http://{}/", listener.local_addr().unwrap())).unwrap();
+    let task = thread::spawn(move || {
+        responses.into_iter().map(|response| {
+            let (mut stream, _) = listener.accept().unwrap();
+            stream.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+            let mut reader = BufReader::new(&mut stream);
+            let mut head = String::new();
+            while !head.ends_with("\r\n\r\n") {
+                assert_ne!(reader.read_line(&mut head).unwrap(), 0);
+            }
+            let length = head.lines().filter_map(|line| line.split_once(':'))
+                .find(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+                .map_or(0, |(_, value)| value.trim().parse::<usize>().unwrap());
+            let mut body = vec![0; length];
+            reader.read_exact(&mut body).unwrap();
+            stream.write_all(response.as_bytes()).unwrap();
+            Received { head, body: String::from_utf8(body).unwrap() }
+        }).collect()
+    });
+    (url, task)
+}
+
+fn response(status: &str, headers: &str, body: &str) -> String {
+    format!("HTTP/1.1 {status}\r\n{headers}Content-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len())
+}
+
+fn browser() -> Browser { Browser::read("profiles/safari-26-ios.json").unwrap() }
+
+#[tokio::test]
+async fn redirects_and_form_posts_share_cookies_pacing_and_one_budget() {
+    let (url, origin) = serve(vec![
+        response("302 Found", "Location: /start\r\nSet-Cookie: session=fixture; Path=/\r\n", ""),
+        response("200 OK", "", "schedule form"),
+        response("200 OK", "", "filtered sections"),
+    ]);
+    let browser = browser();
+    let options = Options::default();
+    let mut session = browser.refresh_session(&options, Duration::from_millis(100), 3,
+        vec!["127.0.0.1".into()]).unwrap();
+    let started = Instant::now();
+    assert_eq!(session.request("GET", &url, &[]).await.unwrap().html, "schedule form");
+    assert_eq!(session.request("POST", &url.join("filter").unwrap(),
+        &[("SEM_filt".into(), "227".into())]).await.unwrap().html, "filtered sections");
+    assert!(started.elapsed() >= Duration::from_millis(200));
+    let error = session.request("GET", &url.join("extra").unwrap(), &[]).await.unwrap_err();
+    assert!(error.chain().filter_map(|e| e.downcast_ref::<std::io::Error>())
+        .any(|e| e.kind() == std::io::ErrorKind::Other));
+    assert_eq!(session.request_count(), 3);
+    let requests = origin.join().unwrap();
+    assert!(requests[1].head.starts_with("GET /start HTTP/1.1"));
+    assert!(requests[1].head.to_ascii_lowercase().contains("cookie: session=fixture"));
+    assert!(requests[2].head.starts_with("POST /filter HTTP/1.1"));
+    assert!(requests[2].head.to_ascii_lowercase().contains("cookie: session=fixture"));
+    assert_eq!(requests[2].body, "SEM_filt=227");
+}
+
+#[tokio::test]
+async fn a_redirect_cannot_escape_the_origin_allowlist() {
+    let (url, origin) = serve(vec![response("302 Found", "Location: https://outside.invalid/\r\n", "")]);
+    let browser = browser();
+    let options = Options::default();
+    let mut session = browser.refresh_session(&options, Duration::from_millis(100), 3,
+        vec!["127.0.0.1".into()]).unwrap();
+    let error = session.request("GET", &url, &[]).await.unwrap_err();
+    assert!(error.chain().filter_map(|e| e.downcast_ref::<std::io::Error>())
+        .any(|e| e.kind() == std::io::ErrorKind::PermissionDenied));
+    assert_eq!(session.request_count(), 1);
+    assert_eq!(origin.join().unwrap()[0].head.lines().next().unwrap(), "GET / HTTP/1.1");
+}
+
+#[tokio::test]
+async fn a_forbidden_page_after_initial_navigation_is_not_solved_or_replayed() {
+    let (url, origin) = serve(vec![response("200 OK", "", "schedule form"), response("403 Forbidden", "", "denied")]);
+    let browser = browser();
+    let options = Options::default();
+    let mut session = browser.refresh_session(&options, Duration::from_millis(100), 5,
+        vec!["127.0.0.1".into()]).unwrap();
+    session.request("GET", &url, &[]).await.unwrap();
+    session.request("GET", &url, &[]).await.unwrap_err();
+    assert_eq!(session.request_count(), 2);
+    assert!(!session.clearance_attempted);
+    assert!(origin.join().unwrap().iter().all(|request| request.head.starts_with("GET / HTTP/1.1")));
+}
+
+#[tokio::test]
+async fn a_hard_forbidden_page_is_reported_without_solving_or_retrying() {
+    let (url, origin) = serve(vec![response("403 Forbidden", "", "denied")]);
+    let browser = browser();
+    let options = Options::default();
+    let mut session = browser.refresh_session(&options, Duration::from_millis(100), 5,
+        vec!["127.0.0.1".into()]).unwrap();
+    let error = session.request("GET", &url, &[]).await.unwrap_err();
+    assert!(matches!(error.downcast_ref::<crate::Error>(),
+        Some(crate::Error::Blocked { status }) if *status == StatusCode::FORBIDDEN));
+    assert_eq!(session.request_count(), 1);
+    assert_eq!(origin.join().unwrap()[0].head.lines().next().unwrap(), "GET / HTTP/1.1");
+}
