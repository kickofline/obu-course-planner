+//! Shared outbound pacing and request budget, applied beneath retries and redirects.
+use std::{io, sync::{Arc, atomic::{AtomicU64, Ordering}}, time::Duration};
+use http::Uri;
+use tokio::{sync::Mutex, time::{Instant, sleep_until}};
+use tower::BoxError;
+
+/// A shared admission gate for every outbound request, including redirects.
+#[derive(Clone)]
+pub struct NetworkGate(Arc<State>);
+
+struct State {
+    interval: Duration,
+    next: Mutex<Instant>,
+    count: AtomicU64,
+    limit: u64,
+    hosts: Vec<String>,
+}
+
+impl NetworkGate {
+    /// Create a gate with a 100 msâ€“10 s interval, a 1â€“1000 request budget, and allowed hosts.
+    /// HTTPS and WSS are permitted; HTTP is permitted only for explicitly allowed loopback tests.
+    pub fn new(interval: Duration, limit: u64, hosts: Vec<String>) -> io::Result<Self> {
+        if !(Duration::from_millis(100)..=Duration::from_secs(10)).contains(&interval)
+            || limit == 0 || limit > 1000 || hosts.is_empty() {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "Invalid network pacing or budget"));
+        }
+        Ok(Self(Arc::new(State { interval, next: Mutex::new(Instant::now()), count: AtomicU64::new(0), limit, hosts })))
+    }
+
+    /// Number of requests admitted across all clients sharing this gate.
+    pub fn count(&self) -> u64 { self.0.count.load(Ordering::Relaxed) }
+
+    pub(crate) async fn acquire(&self, uri: &Uri) -> Result<(), BoxError> {
+        let host = uri.host().unwrap_or("");
+        let local = host == "127.0.0.1" || host == "localhost";
+        if !self.0.hosts.iter().any(|allowed| allowed == host)
+            || !(matches!(uri.scheme_str(), Some("https" | "wss")) || (local && uri.scheme_str() == Some("http"))) {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "Outbound target is outside the refresh allowlist").into());
+        }
+        let mut next = self.0.next.lock().await;
+        if self.count() >= self.0.limit {
+            return Err(io::Error::other("Refresh outbound request budget exhausted").into());
+        }
+        sleep_until(*next).await;
+        self.0.count.fetch_add(1, Ordering::Relaxed);
+        *next = Instant::now() + self.0.interval;
+        Ok(())
+    }
+}
